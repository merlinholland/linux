
config COMMON_CLK_SS528V100
	tristate "SS528V100 Clock Driver"
	depends on ARCH_SS528V100 || COMPILE_TEST
	select RESET_BSP
	default ARCH_BSP
	help
	  Build the clock driver for SS528V100.

