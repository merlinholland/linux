config ARCH_BSP
	bool "Vendor SoC Support"
	select ARM_AMBA
	select ARM_GIC if ARCH_MULTI_V7 && !ARCH_SS318V100 && !ARCH_SS918V100 && !ARCH_SS013V100
	select ARM_VIC if ARCH_MULTI_V5
	select ARM_TIMER_SP804
	select POWER_RESET
	select POWER_SUPPLY

