config AMP_ZRELADDR
	hex 'amp zreladdr'
	depends on ARCH_BSP_AMP
	default "0x32008000" if ARCH_SS318V100 || ARCH_SS918V100 || ARCH_SS013V100
	default "0x82008000" if ARCH_SS812V100 || ARCH_SS813V100 || ARCH_SS312V100 || ARCH_SS313V100 || ARCH_SS011V100 || ARCH_SS012V100
	default "0x42008000" if ARCH_SS101V200 || ARCH_SS101V500 || ARCH_SS101V300 || ARCH_SS101V600
config BSP_ZRELADDR
       hex 'zreladdr'
       default "0x40008000" if ARCH_SS524V100
       default "0x40008000" if ARCH_SS615V100
       default "0x40008000" if ARCH_SS522V100
       default "0x40008000" if ARCH_SS522V101
       default "0x80008000" if ARCH_SS812V100
       default "0x80008000" if ARCH_SS813V100
       default "0x80008000" if ARCH_SS312V100
       default "0x80008000" if ARCH_SS313V100
       default "0x80008000" if ARCH_SS011V100
       default "0x80008000" if ARCH_SS012V100
       default "0x80008000" if ARCH_SS612V100
       default "0x40008000" if ARCH_SS101V200 || ARCH_SS101V500 || ARCH_SS101V300 || ARCH_SS101V600
       default "0x22008000" if ARCH_SS318V100 || ARCH_SS918V100 || ARCH_SS013V100

